# ---- StudioSpace API environment ----
# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studiospace?retryWrites=true&w=majority

# Must be identical to the client's JWT_SECRET (used to sign/verify ss_token)
JWT_SECRET=replace_with_at_least_32_random_characters

# Shared BetterAuth secret
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters

# Comma-separated allowed origins
CLIENT_URL=http://localhost:3000
